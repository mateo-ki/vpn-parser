#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/vpn-parser
CONF=vpn-parser

start_service() {
    config_load "$CONF"

    local enabled
    local listen
    local db
    local api_token

    config_get_bool enabled "main" "enabled" 1
    [ "$enabled" -eq 1 ] || return 0

    config_get listen "main" "listen" "0.0.0.0:8080"
    config_get db "main" "db" "/etc/vpn-parser/vpn-parser.db"
    config_get api_token "main" "api_token" ""

    local db_dir
    db_dir=$(dirname "$db")
    [ -d "$db_dir" ] || mkdir -p "$db_dir"

    procd_open_instance "vpn-parser"
    procd_set_param command "$PROG" --headless --listen "$listen" --db "$db"

    [ -n "$api_token" ] && procd_append_param command --api-token "$api_token"

    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"

    procd_close_instance
}

stop_service() {
    return 0
}

reload_service() {
    stop
    start
}
