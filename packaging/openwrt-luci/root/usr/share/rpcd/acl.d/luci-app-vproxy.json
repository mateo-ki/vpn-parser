{
  "luci-app-vproxy": {
    "description": "Grant access to VProxy service and APIs",
    "read": {
      "uci": [ "vproxy" ],
      "ubus": {
        "service": [ "list" ],
        "luci.vproxy": [
          "get_status",
          "get_stats",
          "get_tasks",
          "list_nodes",
          "list_sources",
          "get_settings",
          "get_export_links"
        ]
      }
    },
    "write": {
      "uci": [ "vproxy" ],
      "ubus": {
        "luci.vproxy": [
          "fetch_all",
          "fetch_source",
          "speedtest",
          "speedtest_one",
          "create_source",
          "update_source",
          "delete_source",
          "delete_node",
          "discover_gists",
          "clean_nodes",
          "update_settings"
        ]
      }
    }
  }
}
